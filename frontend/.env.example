# Copy this file to `.env` if you need to change the value. `.env` is git-ignored.
#
# Address of the AuraCinema FastAPI backend, including the /api/v1 prefix.
# Only variables that start with VITE_ are exposed to the browser code, so never
# put secrets in this file: everything here ends up in the public JavaScript.
# Use 127.0.0.1 rather than "localhost" (same reason as in backend/.env.example).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
