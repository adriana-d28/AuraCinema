# Copy this file to `.env` and adjust the values. Never commit `.env`.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | test | production
APP_ENV=development

# SQLAlchemy URL for PostgreSQL using the psycopg 3 driver.
# The credentials below match docker-compose.yml and are for local development only.
# Use 127.0.0.1 rather than "localhost": on Windows, "localhost" may resolve to
# IPv6 (::1) first, while the Docker port is published on IPv4 only.
DATABASE_URL=postgresql+psycopg://auracinema:auracinema_dev_password@127.0.0.1:5432/auracinema

# Separate database used ONLY by the automated tests. Its name must end in
# "_test"; the test suite drops and recreates all tables in it.
TEST_DATABASE_URL=postgresql+psycopg://auracinema:auracinema_dev_password@127.0.0.1:5432/auracinema_test

# JWT signing secret (minimum 32 characters). The application refuses to start
# while this placeholder is still in use.
JWT_SECRET_KEY=change-me-generate-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of browser origins allowed to call the API (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# TMDB (The Movie Database) - optional. Paste the "API Read Access Token"
# (not the shorter "API Key") from https://www.themoviedb.org/settings/api.
# It is used only by the maintenance scripts (scripts/refresh_movie_metadata.py
# and scripts/validate_tmdb_ids.py). The API never calls TMDB: it serves the
# metadata stored in PostgreSQL and works with this value left empty.
# Format (a long text starting with "eyJ"; never commit the real value):
#   TMDB_API_READ_ACCESS_TOKEN=eyJ...paste_your_read_access_token_here
# The line below is intentionally empty so a copied .env never holds a fake token.
TMDB_API_READ_ACCESS_TOKEN=
# Seconds to wait for one TMDB request before giving up (0 < value <= 30).
TMDB_TIMEOUT_SECONDS=5
# Stored metadata older than this number of days is refreshed (1-3650).
TMDB_METADATA_REFRESH_DAYS=30

# Credentials used by docker-compose.yml to initialise the PostgreSQL container.
POSTGRES_USER=auracinema
POSTGRES_PASSWORD=auracinema_dev_password
POSTGRES_DB=auracinema

# Website container ("web", Caddy). Used only with the "web" Compose profile.
# Address the site is served on:
#   :80                       plain HTTP, for testing the full stack locally
#   auracinema.duckdns.org    on the server: a public domain pointing to the
#                             server's IP; Caddy then enables HTTPS automatically
SITE_ADDRESS=:80
# On the server, uncomment so `docker compose up -d` also starts the website:
# COMPOSE_PROFILES=web
