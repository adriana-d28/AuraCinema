# Docker build context = repository root (backend/docker-compose.yml, service "api").
# Allow-list: exclude EVERYTHING, then re-include only what the API image copies.
# This keeps the MovieLens data (ml/data/ml-32m), the processed training/test
# datasets (ml/data/processed, about 750 MB), .env files, virtual environments,
# tests and documentation out of the build context and out of the image.
*

!backend/requirements.txt
!backend/alembic.ini
!backend/alembic
!backend/app
!backend/scripts
!ml/src
!ml/data/models
# The movie catalogue (about 300 KB) used by scripts/seed_movies.py, so a fresh
# server can load the catalogue. The other processed files stay excluded.
!ml/data/processed/movies_catalogue.csv

# Never send caches, even inside the allowed folders.
**/__pycache__
**/*.py[cod]
